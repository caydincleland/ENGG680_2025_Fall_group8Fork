    "  # === 1. Construct the design matrix A ===\n",
    "    # Each column corresponds to a^power (starting from degree 0 up to deg)\n",
    "    A = np.vander(a, N=deg + 1, increasing=True)\n",
    "\n",
    "    # === 2. Perform Linear Least Squares Estimation (LSE) ===\n",
    "    # Normal equation: x = (Aᵀ P A)⁻¹ Aᵀ P l\n",
    "    N = A.T @ P @ A                 # Normal matrix\n",
    "    U = A.T @ P @ l                 # Right-hand side vector\n",
    "    x = np.linalg.inv(N) @ U        # Estimated polynomial coefficients\n",
    "\n",
    "    # === 3. Compute residuals ===\n",
    "    l_hat = A @ x                   # Fitted (predicted) observations\n",
    "    v = l - l_hat                   # Residuals = observed - predicted\n",
    "\n",
    "    # === 4. Compute a posterior variance factor (goodness of fit) ===\n",
    "    # apv = (vᵀ P v) / (n - m), where m = number of parameters\n",
    "    n = len(l)\n",
    "    m = len(x)\n",
    "    apv = float((v.T @ P @ v) / (n - m))\n",
    "\n",
    "    # === 5. Compute covariance matrix of estimated coefficients ===\n",
    "    cov_x = apv * np.linalg.inv(N)\n",
    "\n",
    "    return (x, cov_x, apv, v)\n"
   ],
