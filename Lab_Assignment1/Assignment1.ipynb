    "# ...\n",
    "import numpy as np\n",
    "\n",
    "# make sure l_true is a 1D array\n",
    "l_true = np.asarray(l_true).ravel()\n",
    "\n",
    "def polyval_inc(coeffs_inc, x):\n",
    "    # coeffs are [a0, a1, ..., adeg]; polyval wants highest->lowest\n",
    "    return np.polyval(coeffs_inc[::-1], x)\n",
    "\n",
    "# pick an x-grid that matches l_true's length\n",
    "if 'x_true' in globals() and len(x_true) == len(l_true):\n",
    "    x_match = x_true\n",
    "elif 'x_smooth' in globals() and len(x_smooth) == len(l_true):\n",
    "    x_match = x_smooth\n",
    "else:\n",
    "    # reconstruct a smooth grid over the data range with exactly len(l_true) points\n",
    "    x_match = np.linspace(np.min(x_data), np.max(x_data), len(l_true))\n",
    "\n",
    "# evaluate predictions on this matching grid\n",
    "quad_pred  = polyval_inc(results_deg2[0], x_match)\n",
    "quart_pred = polyval_inc(results_deg4[0], x_match)\n",
    "hex_pred   = polyval_inc(results_deg6[0], x_match)\n",
    "\n",
    "# norms (now shapes match)\n",
    "norm_deg2 = np.linalg.norm(quad_pred  - l_true)\n",
    "norm_deg4 = np.linalg.norm(quart_pred - l_true)\n",
    "norm_deg6 = np.linalg.norm(hex_pred   - l_true)\n",
    "\n",
    "print(\"Norm (deg 2):\", norm_deg2)\n",
    "print(\"Norm (deg 4):\", norm_deg4)\n",
    "print(\"Norm (deg 6):\", norm_deg6)"
